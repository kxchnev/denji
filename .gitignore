node_modules/
dist/
# Generated from the core's vocabulary by packages/vscode/scripts/generate-grammar.ts
packages/vscode/syntaxes/
# Generated from simple-icons by packages/core/scripts/generate-icons.ts. Five
# megabytes of path data: the build writes them, so they can never go stale, and
# the history never carries them.
packages/core/src/model/icon.data.ts
packages/core/src/model/icon.names.ts
# Стенд для выбора автоматической раскладки: шесть кандидатов, корпус диаграмм и
# генератор контрольного листа. Прототипное качество и одноразовая задача —
# выбрать движок; то, что выберут, переезжает в src уже с тестами.
packages/core/lab/
# Copied from LANGUAGE.md and the skill by packages/docs/scripts/copy-agent-files.ts,
# so the site can never serve an older grammar than the parser speaks.
packages/docs/public/
# `.next*` rather than `.next`: the dev server works in its own `.next-dev` so a
# build cannot pull the rug from under it (packages/docs/next.config.ts).
.next*/
out/
*.tsbuildinfo
*.vsix
.DS_Store
