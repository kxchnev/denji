{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run the extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/packages/vscode",
        "${workspaceFolder}/packages/vscode/examples/sample.denji"
      ],
      "outFiles": ["${workspaceFolder}/packages/vscode/dist/**/*.js"],
      "preLaunchTask": "npm: build - denji"
    }
  ]
}
