{
  "name": "power",
  "version": "0.0.1",
  "description": "Diagrams with controllable layout \u2014 a mermaid alternative where you can actually place things",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "power": "./dist/cli.js"
  },
  "files": [
    "dist",
    "LANGUAGE.md"
  ],
  "scripts": {
    "prebuild": "npm run icons",
    "build": "tsc",
    "prewatch": "npm run icons",
    "watch": "tsc --watch --preserveWatchOutput",
    "dev": "tsx",
    "pretest": "npm run icons",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretypecheck": "npm run icons",
    "typecheck": "tsc --noEmit",
    "icons": "tsx scripts/generate-icons.ts"
  },
  "keywords": [
    "diagram",
    "flowchart",
    "sequence-diagram",
    "mermaid",
    "svg",
    "layout"
  ],
  "license": "MIT",
  "dependencies": {
    "commander": "^12.1.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "simple-icons": "^16.27.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
