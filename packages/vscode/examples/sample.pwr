# A file to open while working on the extension.
# Open the preview to the side (Cmd+K V), then drag a node onto another one —
# the drop writes a relation, not a coordinate, and everything keeps arranging
# itself around it.
#
# Nothing below says where anything goes. The connections do.

architecture
  group edge "Edge" {
    text "public"
    app cdn "CDN"
    app waf "WAF"
    cdn -> waf
  }

  service orders "Orders" {
    app api "Orders API" @icon(nodedotjs)
    database db "Postgres" @icon(postgresql)
    queue bus "Events"
    api -> db
    api -> bus
  }

  service pay "Payments" {
    app papi "Payments API"
    database pdb "Postgres"
    papi -> pdb
  }

  app worker "Payouts" @icon(go)
  database ledger "Ledger"

  waf -> api : https
  api -> papi : charge
  bus -> worker
  papi -> worker
  worker -> ledger
  worker -> db
