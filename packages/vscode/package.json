{
  "name": "denji",
  "displayName": "Denji — architecture diagrams",
  "description": "Live preview for .denji architecture diagrams — drag a node, the source learns where it belongs",
  "version": "1.2.0",
  "license": "MIT",
  "publisher": "kxchnev",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/kxchnev/denji.git",
    "directory": "packages/vscode"
  },
  "homepage": "https://github.com/kxchnev/denji#readme",
  "bugs": {
    "url": "https://github.com/kxchnev/denji/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization"
  ],
  "keywords": [
    "architecture",
    "diagram",
    "diagram-as-code",
    "dsl",
    "svg"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "The extension only parses and renders the open document; it runs nothing from the workspace."
    }
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:denji",
    "onWebviewPanel:denji.preview"
  ],
  "contributes": {
    "languages": [
      {
        "id": "denji",
        "aliases": [
          "Denji",
          "denji"
        ],
        "extensions": [
          ".denji"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "denji",
        "scopeName": "source.denji",
        "path": "./syntaxes/denji.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "denji.showPreview",
        "title": "Open Preview",
        "category": "denji",
        "icon": "$(open-preview)"
      },
      {
        "command": "denji.showPreviewToSide",
        "title": "Open Preview to the Side",
        "category": "denji",
        "icon": "$(open-preview)"
      },
      {
        "command": "denji.exportSVG",
        "title": "Export as SVG…",
        "category": "denji",
        "icon": "$(file-media)"
      },
      {
        "command": "denji.exportPNG",
        "title": "Export as PNG…",
        "category": "denji",
        "icon": "$(file-media)"
      },
      {
        "command": "denji.exportJPEG",
        "title": "Export as JPEG…",
        "category": "denji",
        "icon": "$(file-media)"
      }
    ],
    "keybindings": [
      {
        "command": "denji.showPreview",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v",
        "when": "editorLangId == denji"
      },
      {
        "command": "denji.showPreviewToSide",
        "key": "ctrl+k v",
        "mac": "cmd+k v",
        "when": "editorLangId == denji"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "denji.showPreviewToSide",
          "when": "editorLangId == denji",
          "group": "navigation"
        },
        {
          "submenu": "denji.export",
          "when": "resourceLangId == denji || activeWebviewPanelId == denji.preview",
          "group": "1_denji"
        }
      ],
      "commandPalette": [
        {
          "command": "denji.showPreview",
          "when": "editorLangId == denji"
        },
        {
          "command": "denji.showPreviewToSide",
          "when": "editorLangId == denji"
        },
        {
          "command": "denji.exportSVG",
          "when": "resourceLangId == denji || activeWebviewPanelId == denji.preview"
        },
        {
          "command": "denji.exportPNG",
          "when": "resourceLangId == denji || activeWebviewPanelId == denji.preview"
        },
        {
          "command": "denji.exportJPEG",
          "when": "resourceLangId == denji || activeWebviewPanelId == denji.preview"
        }
      ],
      "explorer/context": [
        {
          "submenu": "denji.export",
          "when": "resourceExtname == .denji",
          "group": "2_workspace"
        }
      ],
      "editor/context": [
        {
          "submenu": "denji.export",
          "when": "resourceLangId == denji",
          "group": "2_denji"
        }
      ],
      "editor/title/context": [
        {
          "submenu": "denji.export",
          "when": "resourceLangId == denji"
        }
      ],
      "denji.export": [
        {
          "command": "denji.exportSVG",
          "group": "1_export@1"
        },
        {
          "command": "denji.exportPNG",
          "group": "1_export@2"
        },
        {
          "command": "denji.exportJPEG",
          "group": "1_export@3"
        }
      ]
    },
    "configuration": {
      "title": "denji",
      "properties": {
        "denji.diagnostics": {
          "type": "string",
          "enum": [
            "all",
            "errors",
            "off"
          ],
          "enumDescriptions": [
            "Errors and layout warnings, the same list `denji check` prints.",
            "Only what stops the diagram rendering.",
            "Nothing."
          ],
          "default": "all",
          "description": "What to report in the Problems panel."
        },
        "denji.preview.codeLens": {
          "type": "boolean",
          "default": true,
          "description": "Offer 'Open preview to the side' above the first line of a .denji file, until a preview is open."
        },
        "denji.preview.grid": {
          "type": "boolean",
          "default": true,
          "description": "Draw a dot grid behind the diagram."
        },
        "denji.preview.theme": {
          "type": "string",
          "enum": [
            "auto",
            "light",
            "dark"
          ],
          "default": "auto",
          "description": "Palette for the preview. 'auto' follows the editor's colour theme. A document with @theme(...) overrides this."
        }
      }
    },
    "submenus": [
      {
        "id": "denji.export",
        "label": "Export diagram",
        "icon": "$(desktop-download)"
      }
    ]
  },
  "scripts": {
    "grammar": "tsx scripts/generate-grammar.ts",
    "build": "npm run grammar && node esbuild.mjs",
    "watch": "npm run grammar && node esbuild.mjs --watch",
    "test": "npm run build && tsx test/diff.test.ts && tsx test/extension.test.ts && tsx test/grammar.test.ts && tsx test/open.test.ts && tsx test/webview.test.ts && tsx test/export.test.ts",
    "typecheck": "tsc --noEmit",
    "package": "npm run build && vsce package --no-dependencies -o denji.vsix",
    "install:local": "npm run package && node scripts/install-local.mjs",
    "uninstall:local": "node scripts/install-local.mjs --remove"
  },
  "devDependencies": {
    "@kxchnev/denji": "*",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.1.1",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.24.2",
    "jsdom": "^30.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
