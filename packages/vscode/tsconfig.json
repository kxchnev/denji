{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    // `power` is ESM-only and its exports map has no `require` condition, which
    // NodeNext resolution would refuse. Everything here goes through esbuild
    // anyway, so resolve the way the bundler does.
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "vscode"]
  },
  "include": ["src", "webview", "test", "esbuild.mjs"]
}
